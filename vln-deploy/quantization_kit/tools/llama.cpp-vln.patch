+// s2-runner: persistent CLI runner for InternVLA-N1 System-2 over llama.cpp (fork w/ windowed-attn).
+// Loads model+mmproj once, serves line requests on stdin, replies on stdout. One process does
+// image (mtmd) + text generation + traj_latents extraction (no HTTP, no embeddings-mode image limit).
+//
+// Protocol (one request per line, tab-separated; \n in prompt encoded as \\n):
+//   RESET                                  -> "OK"            (clear chat history + KV)
+//   TEXT  \t img1,img2,.. \t <prompt>      -> "OK\t<text>"   (images may be empty)
+//   LATENT                                 -> "OK\t<b64>"    (4*n_embd float32, after a TEXT)
+//   ENCODE \t img1,img2,..                 -> "OK\t<hits>,<misses>"  (S2_EMBD_CACHE>0: vision-embedding prefetch)
+//   CACHE_CLEAR                            -> "OK"            (S2_EMBD_CACHE>0: drop cached embeddings)
+//   QUIT                                   -> exits
+// Launch: s2-runner -m text-latent.gguf --mmproj mmproj.gguf -ngl 99 -c 8192 \
+//                   --temp 0 --repeat-penalty 1.05 --repeat-last-n -1
+#include "arg.h"
+#include "common.h"
+#include "sampling.h"
+#include "llama.h"
+#include "ggml.h"
+#include "chat.h"
+#include "mtmd.h"
+#include "mtmd-helper.h"
+
+#include <string>
+#include <vector>
+#include <sstream>
+#include <iostream>
+#include <cstring>
+#include <cstdlib>
+#include <list>
+#include <unordered_map>
+
+#ifdef S2_RUNNER_ZMQ
+#include <zmq.h>   // serve the same line protocol over a ZMQ REP socket (--zmq tcp://*:PORT)
+#endif
+
+static const int N_QUERY = 4;
+static const char * LATENT_STR = "<|latent_0|><|latent_1|><|latent_2|><|latent_3|>";
+
+struct s2_ctx {
+    mtmd::context_ptr ctx_vision;
+    common_init_result_ptr llama_init;
+    llama_model * model; llama_context * lctx; const llama_vocab * vocab;
+    common_sampler * smpl; llama_batch batch; int n_batch;
+    mtmd::bitmaps bitmaps;
+    common_chat_templates_ptr tmpls; std::vector<common_chat_msg> chat_history; bool use_jinja = false;
+    llama_pos n_past = 0;
+    llama_token last_eog = -1;   // EOG token that ended the last answer (-1 if stopped by n_predict)
+    // S2_HF_CHAT=1: HF chat parity (default system message, EOG of each answer kept in the KV)
+    bool hf_chat = false;
+    bool eog_in_kv = false;      // last answer's EOG token was decoded into the KV
+    // S2_EMBD_CACHE=<n>: LRU of vision embeddings keyed by image content (0 = off, original path)
+    size_t embd_cache_cap = 0;
+    std::list<std::string> embd_lru;   // front = most recently used
+    std::unordered_map<std::string, std::pair<std::vector<float>, std::list<std::string>::iterator>> embd_cache;
+    size_t embd_hits = 0, embd_misses = 0;
+
+    s2_ctx(common_params & params) : llama_init(common_init_from_params(params)) {
+        model = llama_init->model(); lctx = llama_init->context();
+        vocab = llama_model_get_vocab(model);
+        smpl  = common_sampler_init(model, params.sampling);
+        batch = llama_batch_init(std::max(1, params.n_batch), 0, 1);
+        n_batch = params.n_batch;
+        tmpls = common_chat_templates_init(model, params.chat_template);
+        use_jinja = params.use_jinja;
+        const char * clip = params.mmproj.path.c_str();
+        mtmd_context_params mp = mtmd_context_params_default();
+        mp.use_gpu = params.mmproj_use_gpu; mp.print_timings = false;
+        mp.n_threads = params.cpuparams.n_threads; mp.flash_attn_type = params.flash_attn_type;
+        mp.warmup = params.warmup; mp.image_min_tokens = params.image_min_tokens; mp.image_max_tokens = params.image_max_tokens;
+        ctx_vision.reset(mtmd_init_from_file(clip, model, mp));
+        if (!model || !lctx || !ctx_vision.get()) { fprintf(stderr, "load failed\n"); exit(1); }
+        llama_set_embeddings(lctx, false);  // default to generation; toggled on only for LATENT
+        const char * hc = getenv("S2_HF_CHAT");
+        hf_chat = hc != nullptr && std::string(hc) == "1";
+        if (hf_chat) fprintf(stderr, "s2-runner: HF chat parity on (system message + EOG in KV)\n");
+        const char * ec = getenv("S2_EMBD_CACHE");
+        embd_cache_cap = ec != nullptr ? (size_t) std::max(0, atoi(ec)) : 0;
+        if (embd_cache_cap > 0) fprintf(stderr, "s2-runner: vision embedding cache on (%zu entries)\n", embd_cache_cap);
+    }
+    ~s2_ctx() { llama_batch_free(batch); common_sampler_free(smpl); }
+
+    bool load_media(const std::string & f) {
+        mtmd::bitmap bmp(mtmd_helper_bitmap_init_from_file(ctx_vision.get(), f.c_str()));
+        if (!bmp.ptr) return false;
+        if (embd_cache_cap > 0) set_content_id(bmp);
+        bitmaps.entries.push_back(std::move(bmp));
+        return true;
+    }
+    static void set_content_id(mtmd::bitmap & bmp) {   // FNV-1a 64 over (nx, ny, pixels)
+        uint64_t h = 1469598103934665603ULL;
+        auto mix = [&h](const unsigned char * d, size_t n) { for (size_t i = 0; i < n; i++) { h ^= d[i]; h *= 1099511628211ULL; } };
+        uint32_t wh[2] = { bmp.nx(), bmp.ny() };
+        mix((const unsigned char *) wh, sizeof(wh));
+        mix(bmp.data(), bmp.n_bytes());
+        char id[32]; snprintf(id, sizeof(id), "h%016llx", (unsigned long long) h);
+        bmp.set_id(id);
+    }
+    // embeddings of an image chunk: cached copy, or encode now (and cache). nullptr on failure.
+    const float * chunk_embd(const mtmd_input_chunk * chunk) {
+        const std::string key = mtmd_input_chunk_get_id(chunk) ? mtmd_input_chunk_get_id(chunk) : "";
+        auto it = key.empty() ? embd_cache.end() : embd_cache.find(key);
+        if (it != embd_cache.end()) {
+            embd_lru.splice(embd_lru.begin(), embd_lru, it->second.second);
+            embd_hits++;
+            return it->second.first.data();
+        }
+        int64_t t0 = ggml_time_ms();
+        if (mtmd_encode_chunk(ctx_vision.get(), chunk) != 0) return nullptr;
+        fprintf(stderr, "image slice encoded in %lld ms (cache miss)\n", (long long) (ggml_time_ms() - t0));
+        embd_misses++;
+        const size_t n = (size_t) llama_model_n_embd_inp(model) * mtmd_input_chunk_get_n_tokens(chunk);
+        const float * e = mtmd_get_output_embd(ctx_vision.get());
+        if (key.empty()) { scratch.assign(e, e + n); return scratch.data(); }
+        while (embd_cache.size() >= embd_cache_cap && !embd_lru.empty()) {   // evict least recently used
+            embd_cache.erase(embd_lru.back()); embd_lru.pop_back();
+        }
+        embd_lru.push_front(key);
+        auto & slot = embd_cache[key];
+        slot.first.assign(e, e + n); slot.second = embd_lru.begin();
+        return slot.first.data();
+    }
+    std::vector<float> scratch;
+    void cache_clear() { embd_cache.clear(); embd_lru.clear(); }
+    void reset() { eog_in_kv = false; chat_history.clear(); n_past = 0; llama_memory_clear(llama_get_memory(lctx), true); common_sampler_reset(smpl); }
+};
+
+static int eval_chunks_cached(s2_ctx & c, const mtmd_input_chunks * chunks);
+static std::string b64(const unsigned char * d, size_t n);
+
+// decode a user message (prompt + the already-loaded images) into the KV
+static int eval_user(s2_ctx & c, const std::string & prompt) {
+    bool add_bos = c.chat_history.empty();
+    common_chat_msg msg; msg.role = "user"; msg.content = prompt;
+    auto formatted = common_chat_format_single(c.tmpls.get(), c.chat_history, msg, true, c.use_jinja);
+    if (c.hf_chat && c.chat_history.empty()) {   // Qwen2-VL template default system message (HF apply_chat_template)
+        formatted = "<|im_start|>system\nYou are a helpful assistant.<|im_end|>\n" + formatted;
+    }
+    c.chat_history.push_back(msg);
+    mtmd_input_text text; text.text = formatted.c_str(); text.add_special = add_bos; text.parse_special = true;
+    mtmd::input_chunks chunks(mtmd_input_chunks_init());
+    auto bm = c.bitmaps.c_ptr();
+    if (mtmd_tokenize(c.ctx_vision.get(), chunks.ptr.get(), &text, bm.data(), bm.size())) return 1;
+    c.bitmaps.entries.clear();
+    if (getenv("S2_DEBUG") != nullptr) {   // debug: prompt text-chunk token ids
+        fprintf(stderr, "S2_DEBUG prompt n_past %d:", c.n_past);
+        for (size_t i = 0; i < mtmd_input_chunks_size(chunks.ptr.get()); i++) {
+            const mtmd_input_chunk * ch = mtmd_input_chunks_get(chunks.ptr.get(), i);
+            if (mtmd_input_chunk_get_type(ch) != MTMD_INPUT_CHUNK_TYPE_TEXT) { fprintf(stderr, " [IMG n_pos %d]", (int) mtmd_input_chunk_get_n_pos(ch)); continue; }
+            size_t n = 0; const llama_token * t = mtmd_input_chunk_get_tokens_text(ch, &n);
+            for (size_t j = 0; j < n; j++) fprintf(stderr, " %d", t[j]);
+        }
+        fprintf(stderr, "\n");
+    }
+    if (c.hf_chat) {   // HF repetition penalty covers the whole input_ids: add the prompt text tokens to the history
+        for (size_t i = 0; i < mtmd_input_chunks_size(chunks.ptr.get()); i++) {
+            const mtmd_input_chunk * ch = mtmd_input_chunks_get(chunks.ptr.get(), i);
+            if (mtmd_input_chunk_get_type(ch) != MTMD_INPUT_CHUNK_TYPE_TEXT) continue;
+            size_t n = 0;
+            const llama_token * t = mtmd_input_chunk_get_tokens_text(ch, &n);
+            for (size_t j = 0; j < n; j++) common_sampler_accept(c.smpl, t[j], false);
+        }
+    }
+    if (c.embd_cache_cap > 0) return eval_chunks_cached(c, chunks.ptr.get());
+    llama_pos new_past;
+    if (mtmd_helper_eval_chunks(c.ctx_vision.get(), c.lctx, chunks.ptr.get(), c.n_past, 0, c.n_batch, true, &new_past)) return 1;
+    c.n_past = new_past;
+    return 0;
+}
+
+// same as mtmd_helper_eval_chunks(.., logits_last=true), but image embeddings come from the cache
+static int eval_chunks_cached(s2_ctx & c, const mtmd_input_chunks * chunks) {
+    const size_t n_chunks = mtmd_input_chunks_size(chunks);
+    llama_pos n_past = c.n_past;
+    for (size_t i = 0; i < n_chunks; i++) {
+        const mtmd_input_chunk * chunk = mtmd_input_chunks_get(chunks, i);
+        if (mtmd_input_chunk_get_type(chunk) == MTMD_INPUT_CHUNK_TYPE_IMAGE) {
+            const float * e = c.chunk_embd(chunk);
+            if (e == nullptr) return 1;
+            if (mtmd_helper_decode_image_chunk(c.ctx_vision.get(), c.lctx, chunk, const_cast<float *>(e), n_past, 0, c.n_batch, &n_past)) return 1;
+        } else {
+            if (mtmd_helper_eval_chunk_single(c.ctx_vision.get(), c.lctx, chunk, n_past, 0, c.n_batch, i == n_chunks - 1, &n_past)) return 1;
+        }
+    }
+    c.n_past = n_past;
+    return 0;
+}
+
+// ENCODE: tokenize each image alone and fill the cache (no KV / chat-history change)
+static std::string encode_only(s2_ctx & c, const std::string & imgs) {
+    const size_t h0 = c.embd_hits, m0 = c.embd_misses;
+    std::stringstream is(imgs); std::string f;
+    while (std::getline(is, f, ',')) {
+        if (f.empty()) continue;
+        if (!c.load_media(f)) return "ERR\tload";
+        mtmd_input_text text; text.text = mtmd_default_marker(); text.add_special = false; text.parse_special = true;
+        mtmd::input_chunks chunks(mtmd_input_chunks_init());
+        auto bm = c.bitmaps.c_ptr();
+        int32_t r = mtmd_tokenize(c.ctx_vision.get(), chunks.ptr.get(), &text, bm.data(), bm.size());
+        c.bitmaps.entries.clear();
+        if (r) return "ERR\ttokenize";
+        for (size_t i = 0; i < mtmd_input_chunks_size(chunks.ptr.get()); i++) {
+            const mtmd_input_chunk * ch = mtmd_input_chunks_get(chunks.ptr.get(), i);
+            if (mtmd_input_chunk_get_type(ch) == MTMD_INPUT_CHUNK_TYPE_IMAGE && c.chunk_embd(ch) == nullptr) return "ERR\tencode";
+        }
+    }
+    return "OK\t" + std::to_string(c.embd_hits - h0) + "," + std::to_string(c.embd_misses - m0);
+}
+
+static std::string generate_text(s2_ctx & c, int n_predict) {
+    llama_tokens gen;
+    c.last_eog = -1;
+    c.eog_in_kv = false;
+    for (int i = 0; i < n_predict; i++) {
+        if (getenv("S2_DEBUG") != nullptr) {   // debug: raw top-3 logits before sampling
+            const float * lg = llama_get_logits_ith(c.lctx, -1);
+            const int nv = llama_vocab_n_tokens(c.vocab);
+            int b0 = 0, b1 = 1, b2 = 2;
+            for (int v = 0; v < nv; v++) {
+                if (lg[v] > lg[b0]) { b2 = b1; b1 = b0; b0 = v; }
+                else if (v != b0 && lg[v] > lg[b1]) { b2 = b1; b1 = v; }
+                else if (v != b0 && v != b1 && lg[v] > lg[b2]) { b2 = v; }
+            }
+            fprintf(stderr, "S2_DEBUG top %d:%.3f %d:%.3f %d:%.3f\n", b0, lg[b0], b1, lg[b1], b2, lg[b2]);
+        }
+        llama_token id = common_sampler_sample(c.smpl, c.lctx, -1);
+        common_sampler_accept(c.smpl, id, true);
+        if (llama_vocab_is_eog(c.vocab, id)) {   // don't emit the EOS token
+            c.last_eog = id;
+            if (c.hf_chat) {                       // HF keeps it in the sequence: put it into the KV
+                common_batch_clear(c.batch);
+                common_batch_add(c.batch, id, c.n_past++, {0}, false);
+                c.eog_in_kv = llama_decode(c.lctx, c.batch) == 0;
+            }
+            break;
+        }
+        gen.push_back(id);
+        common_batch_clear(c.batch);
+        common_batch_add(c.batch, id, c.n_past++, {0}, true);
+        if (llama_decode(c.lctx, c.batch)) break;
+    }
+    std::string txt = common_detokenize(c.lctx, gen, false);  // skip special tokens (== HF skip_special_tokens)
+    if (getenv("S2_DEBUG") != nullptr) {   // debug: sampled ids + EOG id
+        fprintf(stderr, "S2_DEBUG gen:");
+        for (auto t : gen) fprintf(stderr, " %d", t);
+        fprintf(stderr, " | eog %d | n_past %d\n", c.last_eog, c.n_past);
+    }
+    common_chat_msg m; m.role = "assistant"; m.content = txt; c.chat_history.push_back(m);
+    return txt;
+}
+
+// after a TEXT, append the 4 latent tokens and read their last-layer hidden states = traj_latents
+static std::vector<float> extract_latent(s2_ctx & c) {
+    llama_tokens lat = common_tokenize(c.lctx, LATENT_STR, false, true);
+    // S2_LATENT_WITH_EOS=1: HF parity -- generate_latents() sees prompt + answer + EOG before the latent queries
+    const char * with_eos = getenv("S2_LATENT_WITH_EOS");
+    if (with_eos != nullptr && std::string(with_eos) == "1" && c.last_eog >= 0 && !c.eog_in_kv) {
+        lat.insert(lat.begin(), c.last_eog);
+    }
+    llama_set_embeddings(c.lctx, true);
+    llama_batch b = llama_batch_init((int) lat.size(), 0, 1);
+    for (size_t i = 0; i < lat.size(); i++) common_batch_add(b, lat[i], c.n_past + (int) i, {0}, true);
+    std::vector<float> out;
+    if (!llama_decode(c.lctx, b)) {
+        const int n_embd = llama_model_n_embd(c.model);
+        const int n = (int) lat.size();
+        for (int i = n - N_QUERY; i < n; i++) {
+            const float * e = llama_get_embeddings_ith(c.lctx, i);
+            out.insert(out.end(), e, e + n_embd);
+        }
+    }
+    llama_batch_free(b);
+    // the 4 latent tokens are ephemeral (read-only probe): drop them from the KV so a subsequent
+    // TEXT turn stays position-consistent (required for multi-turn KV reuse; harmless before RESET).
+    llama_memory_seq_rm(llama_get_memory(c.lctx), 0, c.n_past, -1);
+    llama_set_embeddings(c.lctx, false);
+    return out;  // N_QUERY * n_embd
+}
+
+static const char B64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+static std::string b64(const unsigned char * d, size_t n) {
+    std::string o; o.reserve((n + 2) / 3 * 4);
+    for (size_t i = 0; i < n; i += 3) {
+        unsigned v = d[i] << 16 | (i + 1 < n ? d[i + 1] << 8 : 0) | (i + 2 < n ? d[i + 2] : 0);
+        o += B64[v >> 18 & 63]; o += B64[v >> 12 & 63];
+        o += (i + 1 < n) ? B64[v >> 6 & 63] : '='; o += (i + 2 < n) ? B64[v & 63] : '=';
+    }
+    return o;
+}
+
+// Handle one request line; returns the response string (no trailing newline).
+// Identical semantics to the original stdin/stdout loop, so the stdin and ZMQ paths
+// stay bit-for-bit in sync. Sets *quit on QUIT.
+static std::string handle_request(s2_ctx & c, common_params & params, const std::string & line, bool * quit) {
+    std::stringstream ss(line);
+    std::string cmd; std::getline(ss, cmd, '\t');
+    if (cmd == "QUIT") { *quit = true; return "OK"; }
+    if (cmd == "RESET") { c.reset(); return "OK"; }
+    if (cmd == "CACHE_CLEAR") { c.cache_clear(); return "OK"; }
+    if (cmd == "EMBD") {   // debug: vision embeddings of one image (S2_EMBD_CACHE>0)
+        if (c.embd_cache_cap == 0) return "ERR\tcache_off";
+        std::string img; std::getline(ss, img, '\t');
+        if (!c.load_media(img)) return "ERR\tload";
+        mtmd_input_text text; text.text = mtmd_default_marker(); text.add_special = false; text.parse_special = true;
+        mtmd::input_chunks chunks(mtmd_input_chunks_init());
+        auto bm = c.bitmaps.c_ptr();
+        int32_t r = mtmd_tokenize(c.ctx_vision.get(), chunks.ptr.get(), &text, bm.data(), bm.size());
+        c.bitmaps.entries.clear();
+        if (r) return "ERR\ttokenize";
+        for (size_t i = 0; i < mtmd_input_chunks_size(chunks.ptr.get()); i++) {
+            const mtmd_input_chunk * ch = mtmd_input_chunks_get(chunks.ptr.get(), i);
+            if (mtmd_input_chunk_get_type(ch) != MTMD_INPUT_CHUNK_TYPE_IMAGE) continue;
+            const float * e = c.chunk_embd(ch);
+            if (e == nullptr) return "ERR\tencode";
+            const mtmd_image_tokens * it = mtmd_input_chunk_get_tokens_image(ch);
+            const int n_embd = llama_model_n_embd_inp(c.model);
+            const size_t n = (size_t) n_embd * mtmd_input_chunk_get_n_tokens(ch);
+            return "OK\t" + std::to_string(mtmd_image_tokens_get_nx(it)) + "," + std::to_string(mtmd_image_tokens_get_ny(it)) +
+                   "," + std::to_string(n_embd) + "\t" + b64((const unsigned char *) e, n * sizeof(float));
+        }
+        return "ERR\tno_image";
+    }
+    if (cmd == "ENCODE") {
+        if (c.embd_cache_cap == 0) return "ERR\tcache_off";
+        std::string imgs; std::getline(ss, imgs, '\t');
+        return encode_only(c, imgs);
+    }
+    if (cmd == "LATENT") {
+        auto v = extract_latent(c);
+        return std::string("OK\t") + b64((const unsigned char *) v.data(), v.size() * sizeof(float));
+    }
+    if (cmd == "TEXT") {
+        std::string imgs, prompt;
+        std::getline(ss, imgs, '\t'); std::getline(ss, prompt);
+        // decode escaped newlines
+        std::string p; for (size_t i = 0; i < prompt.size(); i++) {
+            if (prompt[i] == '\\' && i + 1 < prompt.size() && prompt[i + 1] == 'n') { p += '\n'; i++; } else p += prompt[i];
+        }
+        if (!imgs.empty()) { std::stringstream is(imgs); std::string f; while (std::getline(is, f, ',')) if (!f.empty()) c.load_media(f); }
+        if (eval_user(c, p)) return "ERR\teval";
+        std::string txt = generate_text(c, params.n_predict);
+        for (auto & ch : txt) if (ch == '\n' || ch == '\t') ch = ' ';
+        return std::string("OK\t") + txt;
+    }
+    return "ERR\tunknown_cmd";
+}
+
+#ifdef S2_RUNNER_ZMQ
+// Serve the same request/response protocol over a ZMQ REP socket. One request per message
+// (trailing newline optional). Each request gets exactly one reply (REP contract).
+static int run_zmq_server(s2_ctx & c, common_params & params, const std::string & endpoint) {
+    void * ctx  = zmq_ctx_new();
+    void * sock = zmq_socket(ctx, ZMQ_REP);
+    if (zmq_bind(sock, endpoint.c_str()) != 0) {
+        fprintf(stderr, "s2-runner: zmq_bind(%s) failed: %s\n", endpoint.c_str(), zmq_strerror(zmq_errno()));
+        return 1;
+    }
+    fprintf(stderr, "s2-runner: ZMQ REP listening on %s\n", endpoint.c_str()); fflush(stderr);
+    while (true) {
+        zmq_msg_t req; zmq_msg_init(&req);
+        int n = zmq_msg_recv(&req, sock, 0);
+        if (n < 0) { zmq_msg_close(&req); if (zmq_errno() == ETERM) break; continue; }
+        std::string line((const char *) zmq_msg_data(&req), zmq_msg_size(&req));
+        zmq_msg_close(&req);
+        if (!line.empty() && line.back() == '\n') line.pop_back();   // tolerate a trailing newline
+        bool quit = false;
+        std::string resp = handle_request(c, params, line, &quit);
+        zmq_send(sock, resp.data(), resp.size(), 0);                 // REP must always reply
+        if (quit) break;
+    }
+    zmq_close(sock); zmq_ctx_destroy(ctx);
+    return 0;
+}
+#endif
+
+int main(int argc, char ** argv) {
+    // --zmq <endpoint> is OUR flag, not a llama.cpp one: strip it before common_params_parse.
+    std::string zmq_ep;
+    std::vector<char *> av;
+    for (int i = 0; i < argc; i++) {
+        if (std::string(argv[i]) == "--zmq" && i + 1 < argc) { zmq_ep = argv[++i]; }
+        else av.push_back(argv[i]);
+    }
+
+    common_params params;
+    if (!common_params_parse((int) av.size(), av.data(), params, LLAMA_EXAMPLE_MTMD)) return 1;
+    if (params.mmproj.path.empty()) { fprintf(stderr, "ERR: --mmproj required\n"); return 1; }
+    if (params.n_predict < 0) params.n_predict = 128;
+    // allocate the per-token embedding buffer (for LATENT); generation still works (generative model)
+    params.embedding = true;
+    params.pooling_type = LLAMA_POOLING_TYPE_NONE;
+    s2_ctx c(params);
+    fprintf(stderr, "s2-runner: ready\n"); fflush(stderr);
+
+    if (!zmq_ep.empty()) {
+#ifdef S2_RUNNER_ZMQ
+        return run_zmq_server(c, params, zmq_ep);
+#else
+        fprintf(stderr, "s2-runner: --zmq requested but this binary was built without libzmq\n");
+        return 1;
+#endif
+    }
+
+    // default: persistent stdin/stdout line protocol (unchanged)
+    std::string line;
+    while (std::getline(std::cin, line)) {
+        bool quit = false;
+        std::string resp = handle_request(c, params, line, &quit);
+        if (quit) break;
+        std::cout << resp << "\n"; std::cout.flush();
+    }
+    return 0;
+}
