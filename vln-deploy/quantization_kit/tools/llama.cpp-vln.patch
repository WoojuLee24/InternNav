diff --git a/tools/mtmd/guidedog-cli.cpp b/tools/mtmd/guidedog-cli.cpp
new file mode 100755
index 000000000..024df7b78
--- /dev/null
+++ b/tools/mtmd/guidedog-cli.cpp
@@ -0,0 +1,394 @@
+// Guidedog ZMQ server built on the mtmd (multimodal) API.
+//
+// Receives frames from cam_server (ZMQ PUB on tcp://*:5555), runs the
+// Qwen2.5-VL model, parses the model's XML tags from the generated text, and
+// pushes each tagged segment (prefixed with a float speech rate) to the TTS
+// server (ZMQ PULL on tcp://localhost:4070). Generation stops at </recommend>.
+//
+// This is the modern replacement for the old examples/llava/qwen2vl-cli.cpp
+// from the on-device-guidedog fork: same ZMQ wire protocol and tag/rate logic,
+// but using libmtmd so it loads current Qwen2.5-VL mmproj files.
+
+#include "arg.h"
+#include "log.h"
+#include "common.h"
+#include "sampling.h"
+#include "llama.h"
+#include "ggml.h"
+#include "chat.h"
+#include "mtmd.h"
+#include "mtmd-helper.h"
+
+#include <zmq.hpp>
+
+#include <vector>
+#include <string>
+#include <cstring>
+#include <climits>
+#include <clocale>
+
+#if defined (__unix__) || (defined (__APPLE__) && defined (__MACH__))
+#include <signal.h>
+#include <unistd.h>
+#endif
+
+static volatile bool g_is_generating   = false;
+static volatile bool g_is_interrupted  = false;
+
+#if defined (__unix__) || (defined (__APPLE__) && defined (__MACH__))
+static void sigint_handler(int signo) {
+    if (signo == SIGINT) {
+        if (g_is_generating) {
+            g_is_generating = false;
+        } else {
+            if (g_is_interrupted) {
+                _exit(1);
+            }
+            g_is_interrupted = true;
+        }
+    }
+}
+#endif
+
+// ---- guidedog-specific options (parsed out of argv before the common parser) ----
+struct guidedog_opts {
+    bool        enabled      = false;                    // --zmq
+    std::string sub_endpoint = "tcp://localhost:5555";   // image source (cam_server)
+    std::string pub_endpoint = "tcp://localhost:4070";   // TTS sink
+
+    // per-tag ZMQ enable + speech rate (defaults match the original fork)
+    bool  en_dest = true, en_left = true, en_right = true, en_path = true, en_rec = true;
+    float r_dest = 2.5f,  r_left = 3.0f,  r_right = 3.0f,  r_path = 2.5f,  r_rec = 2.5f;
+};
+
+// pull our custom flags out of argv; everything else is left for common_params_parse
+static std::vector<char *> extract_guidedog_opts(int argc, char ** argv, guidedog_opts & g) {
+    std::vector<char *> keep;
+    keep.reserve(argc);
+    auto val = [&](int & i) -> const char * { return (i + 1 < argc) ? argv[++i] : nullptr; };
+    for (int i = 0; i < argc; i++) {
+        const std::string a = argv[i];
+        if      (a == "--zmq")               { g.enabled  = true; }
+        else if (a == "--no-zmq-dest-desc")  { g.en_dest  = false; }
+        else if (a == "--no-zmq-left-desc")  { g.en_left  = false; }
+        else if (a == "--no-zmq-right-desc") { g.en_right = false; }
+        else if (a == "--no-zmq-path-desc")  { g.en_path  = false; }
+        else if (a == "--no-zmq-recommend")  { g.en_rec   = false; }
+        else if (a == "--dest-desc-rate")    { if (auto v = val(i)) g.r_dest  = std::stof(v); }
+        else if (a == "--left-desc-rate")    { if (auto v = val(i)) g.r_left  = std::stof(v); }
+        else if (a == "--right-desc-rate")   { if (auto v = val(i)) g.r_right = std::stof(v); }
+        else if (a == "--path-desc-rate")    { if (auto v = val(i)) g.r_path  = std::stof(v); }
+        else if (a == "--recommend-rate")    { if (auto v = val(i)) g.r_rec   = std::stof(v); }
+        else if (a == "--zmq-sub")           { if (auto v = val(i)) g.sub_endpoint = v; }
+        else if (a == "--zmq-pub")           { if (auto v = val(i)) g.pub_endpoint = v; }
+        else { keep.push_back(argv[i]); }
+    }
+    return keep;
+}
+
+struct gd_context {
+    mtmd::context_ptr  ctx_vision;
+    common_init_result_ptr llama_init;
+
+    llama_model       * model;
+    llama_context     * lctx;
+    const llama_vocab * vocab;
+    common_sampler    * smpl;
+    llama_batch         batch;
+    int                 n_batch;
+
+    mtmd::bitmaps bitmaps;
+
+    common_chat_templates_ptr        tmpls;
+    std::vector<common_chat_msg>     chat_history;
+    bool      use_jinja = false;
+    llama_pos n_past    = 0;
+
+    gd_context(common_params & params) : llama_init(common_init_from_params(params)) {
+        model   = llama_init->model();
+        lctx    = llama_init->context();
+        vocab   = llama_model_get_vocab(model);
+        smpl    = common_sampler_init(model, params.sampling);
+        batch   = llama_batch_init(1, 0, 1);
+        n_batch = params.n_batch;
+        if (!model || !lctx) {
+            exit(1);
+        }
+        if (!llama_model_chat_template(model, nullptr) && params.chat_template.empty()) {
+            LOG_ERR("Model does not have a chat template.\n");
+            exit(1);
+        }
+        tmpls     = common_chat_templates_init(model, params.chat_template);
+        use_jinja = params.use_jinja;
+
+        const char * clip_path = params.mmproj.path.c_str();
+        mtmd_context_params mparams = mtmd_context_params_default();
+        mparams.use_gpu         = params.mmproj_use_gpu;
+        mparams.print_timings   = true;
+        mparams.n_threads       = params.cpuparams.n_threads;
+        mparams.flash_attn_type = params.flash_attn_type;
+        mparams.warmup          = params.warmup;
+        mparams.image_min_tokens = params.image_min_tokens;
+        mparams.image_max_tokens = params.image_max_tokens;
+        ctx_vision.reset(mtmd_init_from_file(clip_path, model, mparams));
+        if (!ctx_vision.get()) {
+            LOG_ERR("Failed to load vision model from %s\n", clip_path);
+            exit(1);
+        }
+    }
+
+    ~gd_context() {
+        llama_batch_free(batch);
+        common_sampler_free(smpl);
+    }
+
+    // fresh state for a new image (no model reload)
+    void reset() {
+        n_past = 0;
+        chat_history.clear();
+        bitmaps.entries.clear();
+        common_sampler_reset(smpl);
+        llama_memory_clear(llama_get_memory(lctx), true);
+    }
+
+    // tokenize (image + text) and evaluate the prompt
+    int eval_user(common_chat_msg & msg) {
+        const bool add_bos = chat_history.empty();
+        auto formatted = common_chat_format_single(tmpls.get(), chat_history, msg, true, use_jinja);
+        chat_history.push_back(msg);
+
+        mtmd_input_text text;
+        text.text          = formatted.c_str();
+        text.add_special   = add_bos;
+        text.parse_special = true;
+
+        mtmd::input_chunks chunks(mtmd_input_chunks_init());
+        auto bmp_ptrs = bitmaps.c_ptr();
+        if (mtmd_tokenize(ctx_vision.get(), chunks.ptr.get(), &text, bmp_ptrs.data(), bmp_ptrs.size()) != 0) {
+            LOG_ERR("mtmd_tokenize failed\n");
+            return 1;
+        }
+        bitmaps.entries.clear();
+
+        llama_pos new_n_past;
+        if (mtmd_helper_eval_chunks(ctx_vision.get(), lctx, chunks.ptr.get(),
+                                    n_past, 0, n_batch, true, &new_n_past)) {
+            LOG_ERR("mtmd_helper_eval_chunks failed\n");
+            return 1;
+        }
+        n_past = new_n_past;
+        return 0;
+    }
+};
+
+// receive one multipart frame from cam_server.
+// wire format (cam_server.py: struct.pack('iiidff', ...) with native alignment = 32 bytes):
+//   header[0..3]=h, [4..7]=w, [8..11]=c, [16..23]=timestamp(double), [24..27]=goal_x, [28..31]=goal_y
+//   payload = h*w*c raw bytes, BGR order (OpenCV)
+//   optional 3rd part = custom prompt (utf-8)
+static bool receive_frame(zmq::socket_t & sub, int & w, int & h, float & gx, float & gy,
+                          std::vector<unsigned char> & rgb, std::string & custom_prompt) {
+    zmq::message_t header;
+    if (!sub.recv(header, zmq::recv_flags::none)) return false;
+    if (header.size() < 32) {
+        LOG_ERR("[zmq] header too small (%zu bytes)\n", header.size());
+        return false;
+    }
+    const char * hd = static_cast<const char *>(header.data());
+    int hh = 0, ww = 0, cc = 0;
+    std::memcpy(&hh, hd + 0, sizeof(int));
+    std::memcpy(&ww, hd + 4, sizeof(int));
+    std::memcpy(&cc, hd + 8, sizeof(int));
+    std::memcpy(&gx, hd + 24, sizeof(float));
+    std::memcpy(&gy, hd + 28, sizeof(float));
+    if (hh <= 0 || ww <= 0 || cc < 3) {
+        LOG_ERR("[zmq] bad header h=%d w=%d c=%d\n", hh, ww, cc);
+        return false;
+    }
+    h = hh; w = ww;
+
+    zmq::message_t img;
+    if (!sub.recv(img, zmq::recv_flags::none)) return false;
+    const size_t expect = (size_t) hh * ww * cc;
+    if (img.size() < expect) {
+        LOG_ERR("[zmq] image payload too small (%zu < %zu)\n", img.size(), expect);
+        return false;
+    }
+    const unsigned char * bgr = static_cast<const unsigned char *>(img.data());
+    rgb.resize((size_t) ww * hh * 3);
+    for (size_t p = 0; p < (size_t) ww * hh; p++) {
+        rgb[p * 3 + 0] = bgr[p * cc + 2]; // R <- B
+        rgb[p * 3 + 1] = bgr[p * cc + 1]; // G
+        rgb[p * 3 + 2] = bgr[p * cc + 0]; // B <- R
+    }
+
+    custom_prompt.clear();
+    if (sub.get(zmq::sockopt::rcvmore)) {
+        zmq::message_t pm;
+        if (sub.recv(pm, zmq::recv_flags::none) && pm.size() > 0) {
+            custom_prompt.assign(static_cast<const char *>(pm.data()), pm.size());
+        }
+    }
+    return true;
+}
+
+static void generate_and_publish(gd_context & ctx, const guidedog_opts & g,
+                                 zmq::socket_t & pub, int n_predict) {
+    struct tag_info { std::string open, close; bool enabled; float rate; };
+    const std::vector<tag_info> tags = {
+        {"<dest_desc>",  "</dest_desc>",  g.en_dest,  g.r_dest },
+        {"<left_desc>",  "</left_desc>",  g.en_left,  g.r_left },
+        {"<right_desc>", "</right_desc>", g.en_right, g.r_right},
+        {"<path_desc>",  "</path_desc>",  g.en_path,  g.r_path },
+        {"<recommend>",  "</recommend>",  g.en_rec,   g.r_rec  },
+    };
+    std::vector<bool> sent(tags.size(), false);
+    std::string response;
+
+    for (int i = 0; i < n_predict && g_is_generating && !g_is_interrupted; i++) {
+        llama_token tok = common_sampler_sample(ctx.smpl, ctx.lctx, -1);
+        common_sampler_accept(ctx.smpl, tok, true);
+        if (llama_vocab_is_eog(ctx.vocab, tok)) {
+            break;
+        }
+
+        const std::string piece = common_token_to_piece(ctx.lctx, tok);
+        response += piece;
+        LOG("%s", piece.c_str());
+        fflush(stdout);
+
+        bool stop = false;
+        for (size_t t = 0; t < tags.size(); t++) {
+            if (sent[t]) continue;
+            const size_t cp = response.find(tags[t].close);
+            if (cp == std::string::npos) continue;
+            const size_t op = response.find(tags[t].open);
+            if (op == std::string::npos) continue;
+
+            const size_t cs = op + tags[t].open.size();
+            const std::string content = response.substr(cs, cp - cs);
+            sent[t] = true;
+            LOG_INF("\n[parse] %s -> \"%s\" (rate=%.1f, zmq=%s)\n",
+                    tags[t].open.c_str(), content.c_str(), tags[t].rate,
+                    tags[t].enabled ? "on" : "off");
+
+            if (tags[t].enabled && !content.empty()) {
+                const float rate = tags[t].rate;
+                std::vector<char> buf(sizeof(float) + content.size());
+                std::memcpy(buf.data(), &rate, sizeof(float));
+                std::memcpy(buf.data() + sizeof(float), content.data(), content.size());
+                try {
+                    pub.send(zmq::message_t(buf.data(), buf.size()), zmq::send_flags::none);
+                    LOG_INF("[pub] %s sent (rate=%.1f)\n", tags[t].open.c_str(), rate);
+                } catch (const std::exception & e) {
+                    LOG_ERR("[pub] %s send failed: %s\n", tags[t].open.c_str(), e.what());
+                }
+            }
+            if (tags[t].close == "</recommend>") {
+                LOG_INF("[stop] </recommend> parsed, ending generation\n");
+                stop = true;
+            }
+        }
+        if (stop) break;
+
+        common_batch_clear(ctx.batch);
+        common_batch_add(ctx.batch, tok, ctx.n_past++, {0}, true);
+        if (llama_decode(ctx.lctx, ctx.batch)) {
+            LOG_ERR("llama_decode failed\n");
+            break;
+        }
+    }
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+    ggml_time_init();
+
+    common_params params;
+    common_init();
+
+    guidedog_opts g;
+    std::vector<char *> fargv = extract_guidedog_opts(argc, argv, g);
+
+    if (!common_params_parse((int) fargv.size(), fargv.data(), params, LLAMA_EXAMPLE_MTMD, nullptr)) {
+        return 1;
+    }
+    mtmd_helper_log_set(common_log_default_callback, nullptr);
+
+    if (params.mmproj.path.empty()) {
+        LOG_ERR("ERR: --mmproj is required\n");
+        return 1;
+    }
+    if (!g.enabled) {
+        LOG_ERR("ERR: this is the guidedog ZMQ server; pass --zmq (sub=%s pub=%s)\n",
+                g.sub_endpoint.c_str(), g.pub_endpoint.c_str());
+        return 1;
+    }
+
+    ggml_backend_load_all();
+
+#if defined (__unix__) || (defined (__APPLE__) && defined (__MACH__))
+    {
+        struct sigaction sa;
+        sa.sa_handler = sigint_handler;
+        sigemptyset(&sa.sa_mask);
+        sa.sa_flags = 0;
+        sigaction(SIGINT, &sa, nullptr);
+    }
+#endif
+
+    gd_context ctx(params);
+    const int n_predict = params.n_predict < 0 ? 512 : params.n_predict;
+
+    zmq::context_t zctx(1);
+    zmq::socket_t sub(zctx, zmq::socket_type::sub);
+    sub.connect(g.sub_endpoint);
+    sub.set(zmq::sockopt::subscribe, "");
+    zmq::socket_t pub(zctx, zmq::socket_type::push);
+    pub.connect(g.pub_endpoint);
+
+    LOG_INF("guidedog ZMQ server: SUB %s  ->  PUB %s\n", g.sub_endpoint.c_str(), g.pub_endpoint.c_str());
+    LOG_INF("waiting for frames...\n");
+
+    while (!g_is_interrupted) {
+        int w = 0, h = 0;
+        float gx = 0.f, gy = 0.f;
+        std::vector<unsigned char> rgb;
+        std::string custom_prompt;
+
+        if (!receive_frame(sub, w, h, gx, gy, rgb, custom_prompt)) {
+            continue;
+        }
+        LOG_INF("\n[frame] %dx%d  goal=(%.5f, %.5f)\n", w, h, gx, gy);
+
+        // choose prompt: ZMQ custom prompt overrides; otherwise -p with (x, y) substituted
+        std::string prompt = custom_prompt;
+        if (prompt.empty()) {
+            prompt = params.prompt;
+            const size_t s = prompt.find('(');
+            const size_t e = prompt.find(')');
+            if (s != std::string::npos && e != std::string::npos && e > s) {
+                prompt.replace(s + 1, e - s - 1, std::to_string(gx) + ", " + std::to_string(gy));
+            }
+        }
+        LOG_INF("[prompt] %s\n", prompt.c_str());
+
+        ctx.reset();
+        ctx.bitmaps.entries.push_back(mtmd::bitmap((uint32_t) w, (uint32_t) h, rgb.data()));
+
+        common_chat_msg msg;
+        msg.role    = "user";
+        msg.content = std::string(mtmd_default_marker()) + prompt;
+
+        g_is_generating = true;
+        if (ctx.eval_user(msg)) {
+            continue;
+        }
+        generate_and_publish(ctx, g, pub, n_predict);
+        g_is_generating = false;
+        LOG("\n");
+    }
+
+    LOG_INF("guidedog: interrupted, exiting\n");
+    return 0;
+}
