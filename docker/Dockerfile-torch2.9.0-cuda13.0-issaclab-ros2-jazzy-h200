# 8. 환경 변수 업데이트
ENV NB_USER=$NB_USER \
    HOME=/home/$NB_USER \
    NB_PREFIX=/

USER $NB_USER
WORKDIR /home/$NB_USER

# 9. 실행 설정 (Jupyter Lab)
EXPOSE 8888
CMD ["sh", "-c", "jupyter lab --notebook-dir=/home/irteam --ip=0.0.0.0 --no-browser --allow-root --port=8888 --LabApp.token='' --LabApp.password='' --LabApp.allow_origin='*' --LabApp.base_url=${NB_PREFIX}"]