# gd_vln habitat 이미지 (RTX PRO 6000 Blackwell, sm120) — apptainer 판.
#
# Dockerfile-torch2.9.0-cuda13.0-habitat-jazzy-a5000 을 그대로 옮긴 것.
# a5000/5090 Dockerfile 의 차이는 TRITON_OVERRIDE_ARCH 뿐이라(sm86 / sm100) 여기선 sm120 으로만 바꿨다.
#
# 왜 기존 internnav sandbox 에 overlay 로 얹지 않는가:
#   habitat 이미지의 베이스는 Isaac Sim 이 아니라 ROS 이미지다. Isaac Sim 베이스에 habitat 을 얹으면
#   Isaac 번들 numba(0.59) 와 habitat 이 끌고 오는 llvmlite 가 충돌해서 import 자체가 깨진다
#   (실제로 internnav_habitat_260820.img 가 그 상태다). requirements-habitat.txt 는
#   numba==0.65.0 / llvmlite==0.47.0 으로 짝을 맞춰 고정해 두었다.
#
#   빌드: apptainer build --fakeroot /home/dnwn24/workspace/sif/internnav-habitat.sif docker/habitat-6000pro.def
Bootstrap: docker
From: nvcr.io/nvidia/isaac/ros:noble-ros2_jazzy_d3e84470d576702a380478a513fb3fc6-amd64

%files
    # /tmp 가 아니라 /opt 로 넣는다: apptainer.conf 의 'mount tmp = yes' 때문에
    # 빌드 중 호스트 /tmp 가 컨테이너 /tmp 를 덮어써서 %files 로 넣은 파일이 %post 에서 안 보인다.
    requirements-habitat.txt /opt/requirements-habitat.txt

%environment
    export TRITON_OVERRIDE_ARCH=sm120
    export TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas
    export HABITAT_SIM_EGL_DEVICE_ID=0
    export ACCEPT_EULA=Y
    export PRIVACY_CONSENT=Y

%post
    set -e
    export SRC_ROOT=/ws/src
    export MAX_JOBS=16
    export DEBIAN_FRONTEND=noninteractive
    # RTX PRO 6000 Blackwell = sm120
    export TRITON_OVERRIDE_ARCH=sm120
    export CMAKE_CUDA_ARCHITECTURES=120

    # yarn apt 저장소 키가 만료돼 apt-get update 가 non-zero 로 끝난다 — 나머지 저장소는 정상이라 무시.
    (apt-get update || true) && apt-get install -y --no-install-recommends \
        git vim build-essential python3-pip curl tmux cmake ninja-build ros-jazzy-grid-map-msgs
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --break-system-packages \
        torch==2.9.0 torchvision==0.24.0 --index-url https://download.pytorch.org/whl/cu130
    pip install --no-cache-dir --break-system-packages triton==3.5.0

    # --no-deps: freeze 전체를 그대로 깔아 조합을 고정한다 (resolver 가 버전을 바꾸지 못하게)
    pip install --no-cache-dir --break-system-packages --no-deps --ignore-installed blinker==1.9.0
    pip install --no-cache-dir --break-system-packages --no-deps -r /opt/requirements-habitat.txt

    pip install --no-cache-dir --break-system-packages --no-deps \
        https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.7.16/flash_attn-2.8.3%2Bcu130torch2.9-cp312-cp312-linux_x86_64.whl

    # habitat-sim: C++ 빌드. a5000 이미지와 같은 커밋.
    git clone https://github.com/facebookresearch/habitat-sim.git /opt/habitat-sim
    cd /opt/habitat-sim
    git checkout acbe6f4922e68145e401e55c30f9dfea460a3f24
    git submodule update --init --recursive
    PIP_BREAK_SYSTEM_PACKAGES=1 pip install . --no-deps --no-build-isolation \
        --config-settings="cmake.args=-DHABITATPHYSICS_BUILD_EXTRA=ON"
    cd /
    rm -rf /opt/habitat-sim

    # 마운트된 소스를 editable 처럼 import
    SP=$(python3 -c "import sysconfig; print(sysconfig.get_paths()['purelib'])")
    printf "%s\n" ${SRC_ROOT}/InternNav ${SRC_ROOT}/habitat-lab/habitat-lab ${SRC_ROOT}/habitat-lab/habitat-baselines > $SP/gdvln-src.pth

%runscript
    exec "$@"
