# gd_vln isaac 이미지 (H200, Kubeflow Notebook). 5090 이미지와 패키지가 같고 아래만 다르다:
#   Triton arch sm90 · 코드 위치 /home/irteam/git · uid 1000 = irteam · Jupyter Lab(Isaac python) 으로 시작
# 빌드 (먼저 5090 이미지가 있어야 한다):
#   docker build -t dnwn24/internnav:torch2.7.0-cuda12.8-isaacsim5.1.0-jazzy-h200 -f docker/Dockerfile-torch2.7.0-cuda12.8-isaacsim5.1.0-jazzy-h200 docker
FROM dnwn24/internnav:torch2.7.0-cuda12.8-isaacsim5.1.0-jazzy-5090

ARG NB_USER=irteam
ARG SRC_ROOT=/home/irteam/git
ENV TRITON_OVERRIDE_ARCH=sm90
RUN SP=$($ISAAC_PYTHON -c "import sysconfig; print(sysconfig.get_paths()['purelib'])") \
    && printf "%s\n" ${SRC_ROOT}/InternUtopia ${SRC_ROOT}/InternNav > $SP/gdvln-src.pth \
    && EXISTING_USER=$(getent passwd 1000 | cut -d: -f1) \
    && usermod -l $NB_USER $EXISTING_USER && usermod -d /home/$NB_USER -m $NB_USER \
    && echo "$NB_USER ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && ln -sf /isaac-sim/kit/python/bin/jupyter /usr/local/bin/jupyter
ENV NB_USER=$NB_USER HOME=/home/$NB_USER NB_PREFIX=/
USER $NB_USER
WORKDIR /home/$NB_USER
EXPOSE 8888
CMD ["sh", "-c", "jupyter lab --notebook-dir=/home/irteam --ip=0.0.0.0 --no-browser --allow-root --port=8888 --LabApp.token='' --LabApp.password='' --LabApp.allow_origin='*' --LabApp.base_url=${NB_PREFIX}"]
